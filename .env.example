# DataHub Graph Metadata Service endpoint.
DATAHUB_GMS_URL=http://localhost:8080

# DataHub SDK credential used by the metadata seeding path.
# For an authentication-disabled local Quickstart, use an explicit non-secret placeholder.
DATAHUB_GMS_TOKEN=replace-with-sdk-token

# Role-separated MCP credentials. Secure deployments must provision distinct
# read and write authorities. ToxicJoin does not silently fall back from either
# MCP role to DATAHUB_GMS_TOKEN.
# For an authentication-disabled local Quickstart, both may contain the same
# explicit non-secret placeholder.
DATAHUB_GMS_READ_TOKEN=replace-with-read-scoped-token
DATAHUB_GMS_WRITE_TOKEN=replace-with-document-write-scoped-token

# Official DataHub MCP server launcher for the retained tested profile.
DATAHUB_MCP_COMMAND=uvx
DATAHUB_MCP_ARGS=--from mcp-server-datahub==0.6.0 mcp-server-datahub
DATAHUB_MCP_TIMEOUT_SECONDS=90

# Optional production receipt-authenticity secret (minimum 32 UTF-8 bytes).
# If omitted, ToxicJoin creates a random 256-bit 0600 key beside the receipt directory.
# Do not commit or share a populated value.
# TOXICJOIN_RECEIPT_HMAC_KEY=replace-with-at-least-32-random-bytes
